{
  "$schema": "https://schema.management.azure.com/schemas/2019-08-01/subscriptionDeploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "managedByTenantId": {
      "type": "string",
      "metadata": {
        "description": "Microsoft Entra tenant ID of the managing service provider."
      }
    },
    "mspOfferName": {
      "type": "string",
      "defaultValue": "MSSP SOC Services"
    },
    "mspOfferDescription": {
      "type": "string",
      "defaultValue": "Managed security monitoring and response services."
    },
    "administratorGroupPrincipalId": {
      "type": "string",
      "metadata": {
        "description": "Object ID of the managing-tenant administrator group."
      }
    },
    "administratorGroupPrincipalIdDisplayName": {
      "type": "string",
      "defaultValue": "MSSP SOC Administrators"
    },
    "analystGroupPrincipalId": {
      "type": "string",
      "metadata": {
        "description": "Object ID of the managing-tenant analyst group."
      }
    },
    "analystGroupPrincipalIdDisplayName": {
      "type": "string",
      "defaultValue": "MSSP SOC Analysts"
    },
    "automationPrincipalId": {
      "type": "string",
      "metadata": {
        "description": "Object ID of the managing-tenant automation principal."
      }
    },
    "automationPrincipalIdDisplayName": {
      "type": "string",
      "defaultValue": "MSSP SOC Automation"
    }
  },
  "variables": {
    "mspRegistrationName": "[guid(parameters('mspOfferName'), parameters('managedByTenantId'))]",
    "mspAssignmentName": "[guid(parameters('mspOfferName'), parameters('managedByTenantId'), subscription().subscriptionId)]",
    "authorizations": [
      {
        "principalId": "[parameters('analystGroupPrincipalId')]",
        "roleDefinitionId": "3e150937-b8fe-4cfb-8069-0eaf05ecd056",
        "principalIdDisplayName": "[parameters('analystGroupPrincipalIdDisplayName')]"
      },
      {
        "principalId": "[parameters('administratorGroupPrincipalId')]",
        "roleDefinitionId": "ab8e14d6-4a74-4a29-9ba8-549422addade",
        "principalIdDisplayName": "[parameters('administratorGroupPrincipalIdDisplayName')]"
      },
      {
        "principalId": "[parameters('administratorGroupPrincipalId')]",
        "roleDefinitionId": "92aaf0da-9dab-42b6-94a3-d43ce8d16293",
        "principalIdDisplayName": "[parameters('administratorGroupPrincipalIdDisplayName')]"
      },
      {
        "principalId": "[parameters('automationPrincipalId')]",
        "roleDefinitionId": "f4c81013-99ee-4d62-a7ee-b3f1f648599a",
        "principalIdDisplayName": "[parameters('automationPrincipalIdDisplayName')]"
      },
      {
        "principalId": "[parameters('administratorGroupPrincipalId')]",
        "roleDefinitionId": "51d6186e-6489-4900-b93f-92e23144cca5",
        "principalIdDisplayName": "[parameters('administratorGroupPrincipalIdDisplayName')]"
      },
      {
        "principalId": "[parameters('administratorGroupPrincipalId')]",
        "roleDefinitionId": "b24988ac-6180-42a0-ab88-20f7382dd24c",
        "principalIdDisplayName": "[parameters('administratorGroupPrincipalIdDisplayName')]"
      },
      {
        "principalId": "[parameters('analystGroupPrincipalId')]",
        "roleDefinitionId": "acdd72a7-3385-48ef-bd42-f606fba81ae7",
        "principalIdDisplayName": "[parameters('analystGroupPrincipalIdDisplayName')]"
      },
      {
        "principalId": "[parameters('administratorGroupPrincipalId')]",
        "roleDefinitionId": "acdd72a7-3385-48ef-bd42-f606fba81ae7",
        "principalIdDisplayName": "[parameters('administratorGroupPrincipalIdDisplayName')]"
      },
      {
        "principalId": "[parameters('administratorGroupPrincipalId')]",
        "roleDefinitionId": "91c1777a-f3dc-4fae-b103-61d183457e46",
        "principalIdDisplayName": "[parameters('administratorGroupPrincipalIdDisplayName')]"
      },
      {
        "principalId": "[parameters('administratorGroupPrincipalId')]",
        "roleDefinitionId": "18d7d88d-d35e-4fb5-a5c3-7773c20a72d9",
        "principalIdDisplayName": "[parameters('administratorGroupPrincipalIdDisplayName')]",
        "delegatedRoleDefinitionIds": [
          "00482a5a-887f-4fb3-b363-3b7fe8e74483",
          "12338af0-0e69-4776-bea7-57ae8d297424",
          "14b46e9e-c2b7-41b4-b07b-48a6ebf60603",
          "1c9b6475-caf0-4164-b5a1-2142a7116f4b",
          "21090545-7ca7-4776-b22c-e363652d74d2",
          "3913510d-42f4-4e42-8a64-420c390055eb",
          "4633458b-17de-408a-b874-0445c86b69e6",
          "749f88d5-cbae-40b8-bcfc-e573ddc772fa",
          "8d289c81-5878-46d4-8554-54e1e3d8b5cb",
          "91c1777a-f3dc-4fae-b103-61d183457e46",
          "92aaf0da-9dab-42b6-94a3-d43ce8d16293",
          "ab8e14d6-4a74-4a29-9ba8-549422addade",
          "acdd72a7-3385-48ef-bd42-f606fba81ae7",
          "b24988ac-6180-42a0-ab88-20f7382dd24c",
          "b86a8fe4-44ce-4948-aee5-eccb2c155cd7",
          "f25e0fa2-a7c8-4377-a976-54943a77a395"
        ]
      }
    ]
  },
  "resources": [
    {
      "type": "Microsoft.ManagedServices/registrationDefinitions",
      "apiVersion": "2022-10-01",
      "name": "[variables('mspRegistrationName')]",
      "properties": {
        "registrationDefinitionName": "[parameters('mspOfferName')]",
        "description": "[parameters('mspOfferDescription')]",
        "managedByTenantId": "[parameters('managedByTenantId')]",
        "authorizations": "[variables('authorizations')]"
      }
    },
    {
      "type": "Microsoft.ManagedServices/registrationAssignments",
      "apiVersion": "2022-10-01",
      "name": "[variables('mspAssignmentName')]",
      "properties": {
        "registrationDefinitionId": "[resourceId('Microsoft.ManagedServices/registrationDefinitions/', variables('mspRegistrationName'))]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.ManagedServices/registrationDefinitions/', variables('mspRegistrationName'))]"
      ]
    }
  ],
  "outputs": {
    "mspOfferName": {
      "type": "string",
      "value": "[concat('Managed by', ' ', parameters('mspOfferName'))]"
    },
    "authorizations": {
      "type": "array",
      "value": "[variables('authorizations')]"
    }
  }
}
